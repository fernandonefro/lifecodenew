{
  "name": "@lifecode/monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Lifecode SaMD Enterprise Production Monorepo",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "turbo run db:generate",
    "db:migrate": "pnpm --filter @lifecode/database db:migrate",
    "db:seed": "pnpm --filter @lifecode/database db:seed"
  },
  "devDependencies": {
    "prettier": "^3.2.4",
    "turbo": "^1.12.0",
    "typescript": "^5.3.3"
  },
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
