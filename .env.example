# === APLICAÇÃO ===
NODE_ENV=
PORT=

# === CORS ===
# Allowlist de origens permitidas (separadas por vírgula). NUNCA use '*'.
# Default de dev (se vazio): http://localhost:3000,http://localhost:3001,http://localhost:19006
# Em produção, defina os domínios reais do portal (ex: https://app.lifecode.com.br)
CORS_ALLOWED_ORIGINS=

# === BANCO DE DADOS (POSTGRESQL) ===
# Formato: postgresql://USER:PASS@HOST:5432/DBNAME?schema=public
DATABASE_URL=
DB_NAME=
DB_USER=
DB_PASSWORD=

# === CACHE E FILAS (REDIS) ===
REDIS_URL=
REDIS_PASSWORD=

# === SEGURANÇA JWT ===
# Gerar com: openssl rand -base64 32 (mínimo 32 chars)
JWT_SECRET=
# Tempo de expiração do access token (ex: 15m)
JWT_EXPIRES_IN=
# Tempo de expiração do refresh token (ex: 7d)
REFRESH_TOKEN_EXPIRES_IN=

# === CRIPTOGRAFIA DE CAMPOS SENSÍVEIS (AES-256-GCM) ===
# Segredo forte (recomendado 32+ bytes). Gerar com: openssl rand -hex 32
# Usado em: apps/api/src/common/security/crypto.service.ts (lê ENCRYPTION_KEY).
# Em produção é OBRIGATÓRIA — a API falha ao subir se estiver ausente.
ENCRYPTION_KEY=

# === AUDITORIA (HMAC-SHA256) ===
# Chave para assinar os AuditLogs (integridade). Gerar com: openssl rand -hex 32
# Em produção é OBRIGATÓRIA (a auditoria falha se ausente).
AUDIT_HMAC_KEY=

# === NGINX / DOMÍNIO (PRODUÇÃO) ===
DOMAIN_NAME=

# === SMTP (feature planejada — não implementada no código da API) ===
# Usado apenas no docker-compose.yml para injetar no container da API
SMTP_HOST=
SMTP_PORT=
