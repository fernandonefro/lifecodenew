# === APLICAÇÃO ===
NODE_ENV=
PORT=

# === BANCO DE DADOS (POSTGRESQL) ===
# Formato: postgresql://USER:PASS@HOST:5432/DBNAME?schema=public
DATABASE_URL=
DB_NAME=
DB_USER=
DB_PASSWORD=

# === CACHE E FILAS (REDIS) ===
REDIS_URL=
REDIS_PASSWORD=

# === SEGURANÇA JWT ===
# Gerar com: openssl rand -base64 32 (mínimo 32 chars)
JWT_SECRET=
# Tempo de expiração do access token (ex: 15m)
JWT_EXPIRES_IN=
# Tempo de expiração do refresh token (ex: 7d)
REFRESH_TOKEN_EXPIRES_IN=

# === CRIPTOGRAFIA DE CAMPOS SENSÍVEIS (AES-256-GCM) ===
# DEVE ter exatamente 32 bytes. Gerar com: openssl rand -hex 32 (pegar primeiros 32 chars)
# Usado em: apps/api/src/common/security/crypto.service.ts
FIELD_ENCRYPTION_KEY=

# === NGINX / DOMÍNIO (PRODUÇÃO) ===
DOMAIN_NAME=

# === SMTP (feature planejada — não implementada no código da API) ===
# Usado apenas no docker-compose.yml para injetar no container da API
SMTP_HOST=
SMTP_PORT=
